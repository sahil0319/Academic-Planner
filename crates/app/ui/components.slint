// Shared components built from base elements (DESIGN.md v2 "Components", R84).
// Every color, size, spacing, radius, and font comes from Theme.*; no logic beyond bindings.
import { ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Chip } from "types.slint";

// R84: Carbon focus ring (DESIGN.md "Focus"): a focus-ring-width ring drawn inside the control's bounds, so it
// never changes the control size. `filled` adds the on-primary inner ring that filled buttons
// carry so the ring stays visible on the blue fill. Overlay it as the last child of a control.
// Exported so page-local controls (day cells, tabs, paste box) share it.
export component FocusRing inherits Rectangle {
    in property <bool> filled;
    in property <color> ring-color: Theme.focus;

    border-width: Theme.focus-ring-width;
    border-color: root.ring-color;

    if root.filled: Rectangle {
        x: Theme.focus-ring-width;
        y: Theme.focus-ring-width;
        width: parent.width - 2 * Theme.focus-ring-width;
        height: parent.height - 2 * Theme.focus-ring-width;
        border-width: Theme.focus-inner-width;
        border-color: Theme.on-primary;
    }
}

// R84, R85: left navigation entry. Hover surface-hover; the active item uses surface-selected,
// label weight 600, and a rule-width primary bar on its left edge (not colour alone, DESIGN.md).
// Focus is an inset ring.
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: Theme.nav-item-height;
    border-radius: Theme.radius-none;
    background: root.active ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access (T028 critique): Tab reaches the control, Enter or Space activates it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        Text {
            text: root.text;
            // The nav item carries the accessible label.
            accessible-role: none;
            vertical-alignment: center;
            color: root.active || touch.has-hover ? Theme.on-surface : Theme.on-surface-muted;
            font-family: Theme.font-body;
            font-size: root.active ? Theme.body-emphasis-size : Theme.body-md-size;
            font-weight: root.active ? Theme.body-emphasis-weight : Theme.body-md-weight;
        }
    }

    if root.active: Rectangle {
        x: 0;
        width: Theme.rule-width;
        background: Theme.primary;
    }

    if focus-scope.has-focus: FocusRing {}
}

// R84: primary button; at most one per panel (DESIGN.md). Hover primary-hover, press
// primary-active; disabled surface-selected with on-surface-subtle text.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.input-height;
    min-width: label.preferred-width + 2 * Theme.space-lg;
    horizontal-stretch: 0;
    border-radius: Theme.radius-none;
    background: !root.enabled ? Theme.surface-selected
        : touch.pressed ? Theme.primary-active
        : touch.has-hover ? Theme.primary-hover
        : Theme.primary;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access (T028 critique): Tab reaches the control, Enter or Space activates it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    label := Text {
        text: root.text;
        // The button carries the accessible label.
        accessible-role: none;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? Theme.on-primary : Theme.on-surface-subtle;
        font-family: Theme.font-body;
        font-size: Theme.body-md-size;
        font-weight: Theme.body-md-weight;
    }

    if focus-scope.has-focus: FocusRing {
        filled: true;
    }
}

// R84: shared look of the bordered buttons (field fill, thin edge, hover surface-hover, inset
// focus ring). `SecondaryButton` and `DangerButton` only choose the edge and label colours.
component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> edge-color;
    in property <color> label-color;
    callback clicked();

    height: Theme.input-height;
    min-width: label.preferred-width + 2 * Theme.space-lg;
    horizontal-stretch: 0;
    border-radius: Theme.radius-none;
    border-width: Theme.control-edge-width;
    border-color: root.enabled ? root.edge-color : Theme.border;
    background: root.enabled && touch.has-hover ? Theme.surface-hover : Theme.field;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access (T028 critique): Tab reaches the control, Enter or Space activates it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    label := Text {
        text: root.text;
        // The button carries the accessible label.
        accessible-role: none;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? root.label-color : Theme.on-surface-subtle;
        font-family: Theme.font-body;
        font-size: Theme.body-md-size;
        font-weight: Theme.body-md-weight;
    }

    if focus-scope.has-focus: FocusRing {}
}

// R84: secondary button (field fill, border-strong edge) for row actions such as Attended /
// Absent / Cancelled.
export component SecondaryButton inherits OutlineButton {
    edge-color: Theme.border-strong;
    label-color: Theme.on-surface;
}

// R84: danger button for "Delete selected" and the confirm of a destructive action: same
// interface as `SecondaryButton`, with an error edge and label. Never more than one per panel.
export component DangerButton inherits OutlineButton {
    edge-color: Theme.error;
    label-color: Theme.error;
}

// R84: Carbon text box shared by `Field` and `TimeField`: field fill, border-strong bottom
// rule, inset ring on focus (focus colour) or when invalid (error colour, which wins).
// Width comes from the surrounding layout only: Slint reports a no-wrap `TextInput` minimum and
// preferred width as its text width, so both are zeroed below and long text scrolls inside the clip.
component FieldBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> invalid;
    callback edited(string);

    height: Theme.input-height;
    border-radius: Theme.radius-none;
    background: Theme.field;
    clip: true;

    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        input := TextInput {
            min-width: 0;
            preferred-width: 0;
            vertical-alignment: center;
            color: Theme.on-surface;
            font-family: Theme.font-body;
            font-size: Theme.body-md-size;
            font-weight: Theme.body-md-weight;
            single-line: true;
            edited => {
                root.edited(self.text);
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Theme.control-edge-width;
        background: Theme.border-strong;
    }

    if root.invalid || input.has-focus: FocusRing {
        ring-color: root.invalid ? Theme.error : Theme.focus;
    }
}

// FR-007, R84: labelled text input; a non-empty `error` draws the error ring and is shown below.
export component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text <=> box.text;
    in property <string> error;
    callback edited(string);

    // Width comes from the parent layout (stretch), never from the content or the error line.
    preferred-width: 0;
    spacing: Theme.space-xs;

    Text {
        text: root.label;
        color: Theme.on-surface-muted;
        font-family: Theme.font-body;
        font-size: Theme.label-md-size;
        font-weight: Theme.label-md-weight;
    }

    box := FieldBox {
        invalid: root.error != "";
        edited(value) => {
            root.edited(value);
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.error;
        wrap: word-wrap;
        font-family: Theme.font-body;
        font-size: Theme.body-sm-size;
        font-weight: Theme.body-sm-weight;
    }
}

// Labelled combo box with an error line, matching `Field`. `selected` fires when the user picks
// an entry, not when Rust changes the index. The fluent `ComboBox` itself stays (R84, research D8).
export component ComboField inherits VerticalLayout {
    in property <string> label;
    in property <[string]> model;
    in-out property <int> current-index;
    in property <string> error;
    callback selected();

    // Width comes from the parent layout (stretch), never from the content or the error line.
    preferred-width: 0;
    spacing: Theme.space-xs;

    Text {
        text: root.label;
        color: Theme.on-surface-muted;
        font-family: Theme.font-body;
        font-size: Theme.label-md-size;
        font-weight: Theme.label-md-weight;
    }

    ComboBox {
        height: Theme.input-height;
        model: root.model;
        current-index <=> root.current-index;
        selected(value) => {
            root.selected();
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.error;
        wrap: word-wrap;
        font-family: Theme.font-body;
        font-size: Theme.body-sm-size;
        font-weight: Theme.body-sm-weight;
    }
}

// One AM or PM segment of `AmPmToggle` (R84). The active segment sits on surface-selected with
// label weight 600 (research D11); hover surface-hover; focus is an inset ring.
component AmPmSegment inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    border-radius: Theme.radius-none;
    background: root.active ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.field;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access: Tab reaches the segment, Enter or Space activates it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: Theme.on-surface;
            font-family: Theme.font-body;
            font-size: Theme.body-md-size;
            font-weight: root.active ? Theme.body-emphasis-weight : Theme.body-md-weight;
            accessible-role: none;
        }
    }

    // F-05: the selected tab carries a rule-width primary bar on its bottom edge (the active-nav
    // device), so selection does not rest on weight alone when surface-selected equals field.
    if root.active: Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: Theme.rule-width;
        background: Theme.primary;
    }

    if focus-scope.has-focus: FocusRing {}
}

// R32, R84: AM / PM toggle (`pm` false is AM) for `TimeField`: two square segments inside a
// border-strong edge, as tall as an input field.
export component AmPmToggle inherits Rectangle {
    in-out property <bool> pm;

    width: layout.preferred-width + 2 * Theme.control-edge-width;
    height: Theme.input-height;
    border-radius: Theme.radius-none;
    border-width: Theme.control-edge-width;
    border-color: Theme.border-strong;
    background: Theme.field;

    layout := HorizontalLayout {
        // The border is drawn inside the bounds; keep the children inside it.
        padding: Theme.control-edge-width;
        AmPmSegment {
            label: "AM";
            active: !root.pm;
            clicked => {
                root.pm = false;
            }
        }
        AmPmSegment {
            label: "PM";
            active: root.pm;
            clicked => {
                root.pm = true;
            }
        }
    }
}

// FR-007, R32, R84: labelled time input (digits such as 930) with an AM / PM toggle beside it; a
// non-empty `error` draws the error ring and is shown below, like `Field`.
export component TimeField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text <=> box.text;
    in-out property <bool> pm <=> toggle.pm;
    in property <string> error;
    callback edited(string);

    // Width comes from the parent layout (stretch), never from the content or the error line.
    preferred-width: 0;
    spacing: Theme.space-xs;

    Text {
        text: root.label;
        color: Theme.on-surface-muted;
        font-family: Theme.font-body;
        font-size: Theme.label-md-size;
        font-weight: Theme.label-md-weight;
    }

    HorizontalLayout {
        spacing: Theme.space-sm;

        box := FieldBox {
            invalid: root.error != "";
            edited(value) => {
                root.edited(value);
            }
        }

        toggle := AmPmToggle {}
    }

    if root.error != "": Text {
        text: root.error;
        color: Theme.error;
        wrap: word-wrap;
        font-family: Theme.font-body;
        font-size: Theme.body-sm-size;
        font-weight: Theme.body-sm-weight;
    }
}

// R11, R84: status chip, square like every other shape. The text label is always shown next to
// the color (DESIGN.md): label-sm text, space-sm horizontal padding, space-xs vertical padding.
// The label elides when the chip is squeezed (a long "Rescheduled -> date").
export component StatusChip inherits Rectangle {
    in property <Chip> chip;
    in property <string> text;

    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-none;
    background: root.chip == Chip.attended ? Theme.status-attended-bg
        : root.chip == Chip.absent ? Theme.status-absent-bg
        : root.chip == Chip.cancelled ? Theme.status-cancelled-bg
        : Theme.status-pending-bg;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: root.chip == Chip.attended ? Theme.status-attended
                : root.chip == Chip.absent ? Theme.status-absent
                : root.chip == Chip.cancelled ? Theme.status-cancelled
                : Theme.status-pending;
            font-family: Theme.font-body;
            font-size: Theme.label-sm-size;
            font-weight: Theme.label-sm-weight;
        }
    }
}

// R84: status chip in a left-aligned column of fixed preferred width, so the chips of every row
// start at the same x. The column shrinks (and the chip text elides) before it breaks a narrow row.
export component StatusColumn inherits VerticalLayout {
    in property <Chip> chip;
    in property <string> text;

    horizontal-stretch: 0;
    preferred-width: Theme.status-column-width;
    min-width: 0;
    alignment: center;

    HorizontalLayout {
        alignment: start;
        StatusChip {
            chip: root.chip;
            text: root.text;
        }
    }
}

// R84: section card: surface fill, square, no border, space-lg padding, headline title; children
// stack below the title.
export component SectionCard inherits Rectangle {
    in property <string> title;

    background: Theme.surface;
    border-radius: Theme.radius-none;

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-sm;
        Text {
            text: root.title;
            color: Theme.on-surface;
            font-family: Theme.font-heading;
            font-size: Theme.headline-md-size;
            font-weight: Theme.headline-md-weight;
        }
        @children
    }
}

// R84: one list row: surface background, bottom divider in `border`; children are laid out
// left to right. The vertical inset keeps a row holding a field-height button at the row height
// (row-height, DESIGN.md). Inline padding is space-sm, not the space-lg of DESIGN.md list-row: rows with
// 3 to 4 buttons would otherwise truncate the course label (design review F-08, F-13).
export component ListRow inherits Rectangle {
    min-height: Theme.row-height;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        padding-top: (Theme.row-height - Theme.input-height) / 2;
        padding-bottom: (Theme.row-height - Theme.input-height) / 2;
        spacing: Theme.space-sm;
        alignment: stretch;
        @children
    }

    Rectangle {
        y: parent.height - self.height;
        height: Theme.divider-width;
        background: Theme.border;
    }
}

// R84: muted sentence in its card with space-xl padding, e.g. "No classes today."
export component EmptyState inherits Rectangle {
    in property <string> text;

    min-height: Theme.row-height;

    VerticalLayout {
        padding: Theme.space-xl;
        Text {
            text: root.text;
            color: Theme.on-surface-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            font-family: Theme.font-body;
            font-size: Theme.body-md-size;
            font-weight: Theme.body-md-weight;
        }
    }
}

// R14, R84: below-target banner: below-target-bg fill, square, error rule on the left, space-lg
// padding, text wraps. The "Below target" label is always shown with the color (DESIGN.md: meaning
// is never carried by color alone).
export component Banner inherits Rectangle {
    in property <[string]> lines;

    background: Theme.below-target-bg;
    border-radius: Theme.radius-none;

    VerticalLayout {
        padding: Theme.space-lg;
        padding-left: Theme.space-lg + Theme.rule-width;
        spacing: Theme.space-xs;
        Text {
            text: "Below target";
            color: Theme.below-target;
            font-family: Theme.font-body;
            font-size: Theme.label-md-size;
            font-weight: Theme.label-md-weight;
        }
        for line in root.lines: Text {
            text: line;
            color: Theme.below-target;
            wrap: word-wrap;
            font-family: Theme.font-body;
            font-size: Theme.body-md-size;
            font-weight: Theme.body-md-weight;
        }
    }

    Rectangle {
        x: 0;
        width: Theme.rule-width;
        background: Theme.error;
    }
}

// R84: page title (title-lg, on-surface).
export component PageTitle inherits Text {
    color: Theme.on-surface;
    font-family: Theme.font-heading;
    font-size: Theme.title-lg-size;
    font-weight: Theme.title-lg-weight;
}

// One icon segment of the appearance switch (R84, DESIGN.md "Appearance switch"). `icon` holds SVG
// path commands in a 16 x 16 view box; the icon is stroked, never filled. The selected segment is
// surface-inverse with an on-surface-inverse icon; the others are field fill (hover surface-hover).
component AppearanceSegment inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked();

    width: Theme.appearance-segment;
    height: Theme.appearance-segment;
    border-radius: Theme.radius-none;
    background: root.active ? Theme.surface-inverse : touch.has-hover ? Theme.surface-hover : Theme.field;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access: Tab reaches the segment, Enter or Space activates it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Theme.appearance-icon;
        height: Theme.appearance-icon;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.icon;
        fill: transparent;
        stroke: root.active ? Theme.on-surface-inverse : Theme.on-surface;
        stroke-width: Theme.appearance-icon-stroke;
        accessible-role: none;
    }

    if focus-scope.has-focus: FocusRing {}
}

// Three-way System / Light / Dark switch (§6 "Appearance:", R84, DESIGN.md "Appearance switch"):
// a square segmented control with monitor, sun, and moon segments inside a border-strong edge.
// `selected` is 0 System, 1 Light, 2 Dark; `select(i)` reports the clicked segment and Rust applies
// and saves it.
export component AppearanceSwitch inherits Rectangle {
    in property <int> selected;
    callback select(int);

    // The layout padding already holds the border width on each side, so its preferred size is the
    // outer size: segments fill the inner area exactly, with no gap and no overflow.
    width: layout.preferred-width;
    height: layout.preferred-height;
    border-radius: Theme.radius-none;
    border-width: Theme.control-edge-width;
    border-color: Theme.border-strong;
    background: Theme.field;

    layout := HorizontalLayout {
        // The border is drawn inside the bounds; keep the children inside it.
        padding: Theme.control-edge-width;
        AppearanceSegment {
            label: "Use system appearance";
            // Monitor: screen, neck, and base.
            icon: "M 2 3 L 14 3 L 14 11 L 2 11 Z M 8 11 L 8 13.5 M 5.5 13.5 L 10.5 13.5";
            active: root.selected == 0;
            clicked => {
                root.select(0);
            }
        }
        AppearanceSegment {
            label: "Light";
            // Sun: a circle with eight rays.
            icon: "M 11 8 A 3 3 0 1 1 5 8 A 3 3 0 1 1 11 8 Z M 8 1.5 L 8 3 M 8 13 L 8 14.5 M 1.5 8 L 3 8 M 13 8 L 14.5 8 M 3.4 3.4 L 4.5 4.5 M 11.5 11.5 L 12.6 12.6 M 3.4 12.6 L 4.5 11.5 M 11.5 4.5 L 12.6 3.4";
            active: root.selected == 1;
            clicked => {
                root.select(1);
            }
        }
        AppearanceSegment {
            label: "Dark";
            // Moon: a crescent.
            icon: "M 13.5 10 A 6 6 0 1 1 6 2.5 A 4.8 4.8 0 0 0 13.5 10 Z";
            active: root.selected == 2;
            clicked => {
                root.select(2);
            }
        }
    }
}
