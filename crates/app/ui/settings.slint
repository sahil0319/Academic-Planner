// Settings page (docs/spec.md §6, contracts/ui-bridge.md "SettingsState"): term, holidays, mid exams,
// final exams, reminder settings, backup, restore, CSV export, and the database path. Bindings only; every
// data-derived string comes from Rust (src/pages/settings.rs via src/viewmodel.rs).
import { CheckBox, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { HolidayRow, PastTermRow, PublicHolidayRow } from "types.slint";
import {
    PageTitle, EmptyState, SectionCard, ListRow, Field, PrimaryButton, SecondaryButton, DangerButton,
    ComboField, LinkButton,
} from "components.slint";

export global SettingsState {
    // Row-action errors.
    in property <string> message;

    // Term form (R1, R2). `has-term` is true when an active term exists.
    in property <bool> has-term;
    in-out property <string> term-name;
    in-out property <string> term-start;
    in-out property <string> term-end;
    in property <string> term-start-error;
    in property <string> term-end-error;
    in property <string> term-form-error;
    // R67: read-only Term card of the active term.
    in property <string> term-title;
    in property <string> term-dates;
    in property <string> term-week;
    // R67, R69: the form shows only with no active term or after Edit (Rust computes it).
    in property <bool> term-form-open;
    // Set by Rust on Edit and Cancel; Rust reads it back on refresh so the minute timer keeps
    // the form open.
    in property <bool> term-editing;
    // R68: Archive enablement, the muted reason line, and the inline confirm panel.
    in property <bool> archive-enabled;
    in property <string> archive-hint;
    in property <bool> confirm-archive;
    in property <string> archive-confirm-text;
    // R70: Past terms rows.
    in property <[PastTermRow]> past-terms;

    // Holidays of the active term (human decision §6: one date or an inclusive range).
    in property <[HolidayRow]> holidays;
    in-out property <string> hol-start;
    in-out property <string> hol-end;
    in-out property <string> hol-label;
    in property <string> hol-start-error;
    in property <string> hol-end-error;
    in property <string> hol-form-error;
    // R73: Mid exams and Final exams cards, same shape as the Holidays card.
    in property <[HolidayRow]> midterms;
    in-out property <string> mid-start;
    in-out property <string> mid-end;
    in-out property <string> mid-label;
    in property <string> mid-start-error;
    in property <string> mid-end-error;
    in property <string> mid-form-error;
    in property <[HolidayRow]> finals;
    in-out property <string> fin-start;
    in-out property <string> fin-end;
    in-out property <string> fin-label;
    in property <string> fin-start-error;
    in property <string> fin-end-error;
    in property <string> fin-form-error;

    // R76, R77, R79: Public holidays card. Country choice, fetch status, Retry, the cached
    // public holidays of the active term with a tick each, and the inline error.
    in property <[string]> ph-countries;
    in-out property <int> ph-country-index;
    in property <string> ph-status;
    in property <bool> ph-can-retry;
    in property <[PublicHolidayRow]> ph-rows;
    in property <string> ph-empty-text;
    in property <string> ph-error;

    // Settings form (§3 settings).
    in-out property <string> reminder;
    in-out property <string> window;
    in-out property <bool> notifications;
    in property <string> reminder-error;
    in property <string> window-error;
    in property <string> settings-form-error;

    // R24: database file path as text.
    in property <string> db-path;

    // R22: inline confirm panel shown after a backup file is picked for restore.
    in property <bool> confirm-restore;

    callback save-term();
    callback edit-term();
    callback cancel-term();
    // Opens the archive confirm panel.
    callback archive-term();
    callback archive-confirm();
    callback archive-cancel();
    callback add-holiday();
    callback add-midterm();
    callback add-final();
    callback remove-holiday(string);
    callback save-settings();
    callback backup();
    callback restore-pick();
    callback restore-confirm();
    callback restore-cancel();
    callback export-csv();
    callback ph-country-selected();
    callback ph-retry();
    callback ph-toggle(string, bool);
    callback ph-add-selected();
}

// Form-level error under a form (core R2 errors, no active term).
component FormError inherits Text {
    color: Theme.error;
    wrap: word-wrap;
    font-family: Theme.font-body;
    font-size: Theme.body-sm-size;
    font-weight: Theme.body-sm-weight;
}

// Body text on a card.
component BodyText inherits Text {
    color: Theme.on-surface;
    wrap: word-wrap;
    font-family: Theme.font-body;
    font-size: Theme.body-md-size;
    font-weight: Theme.body-md-weight;
}

// Muted body text on a card.
component MutedText inherits Text {
    color: Theme.on-surface-muted;
    wrap: word-wrap;
    font-family: Theme.font-body;
    font-size: Theme.body-md-size;
    font-weight: Theme.body-md-weight;
}

// R73: one day-off card (Holidays, Mid exams, Final exams): one row per day with Remove, then
// the date, last day, and label fields, the inline form error, and the add button.
component DayOffCard inherits SectionCard {
    in property <[HolidayRow]> rows;
    in property <string> empty-text;
    in property <string> add-text;
    in-out property <string> first-day;
    in-out property <string> last-day;
    in-out property <string> label;
    in property <string> first-error;
    in property <string> last-error;
    in property <string> form-error;
    callback add();
    callback remove(string);

    if root.rows.length == 0: EmptyState {
        text: root.empty-text;
    }

    if root.rows.length > 0: VerticalLayout {
        for row in root.rows: ListRow {
            Text {
                text: row.date;
                vertical-alignment: center;
                color: Theme.on-surface;
                font-family: Theme.font-body;
                font-size: Theme.body-md-size;
                font-weight: Theme.body-md-weight;
            }

            Text {
                text: row.label;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: Theme.on-surface-muted;
                font-family: Theme.font-body;
                font-size: Theme.body-md-size;
                font-weight: Theme.body-md-weight;
            }

            SecondaryButton {
                text: "Remove";
                clicked => {
                    root.remove(row.key);
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-md;
        Field {
            label: "Date or first day (DD-MM-YYYY)";
            text <=> root.first-day;
            error: root.first-error;
        }

        Field {
            label: "Last day, optional (DD-MM-YYYY)";
            text <=> root.last-day;
            error: root.last-error;
        }

        Field {
            label: "Label, optional";
            text <=> root.label;
        }
    }

    if root.form-error != "": FormError {
        text: root.form-error;
    }

    HorizontalLayout {
        alignment: start;
        PrimaryButton {
            text: root.add-text;
            clicked => {
                root.add();
            }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    spacing: Theme.space-xxl;
    alignment: start;

    PageTitle {
        text: "Settings";
    }

    if SettingsState.message != "": BodyText {
        text: SettingsState.message;
    }

    SectionCard {
        title: "Term";

        if !SettingsState.has-term: EmptyState {
            text: "No term saved yet. Enter the term below to start.";
        }

        // R67: the active term read-only, with Edit and Archive.
        if SettingsState.has-term && !SettingsState.term-form-open: VerticalLayout {
            spacing: Theme.space-sm;
            Text {
                text: SettingsState.term-title;
                color: Theme.on-surface;
                wrap: word-wrap;
                font-family: Theme.font-body;
                font-size: Theme.body-emphasis-size;
                font-weight: Theme.body-emphasis-weight;
            }

            MutedText {
                text: SettingsState.term-dates;
            }

            MutedText {
                text: SettingsState.term-week;
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                SecondaryButton {
                    text: "Edit";
                    clicked => {
                        SettingsState.edit-term();
                    }
                }

                // R68: disabled until the end date has passed.
                DangerButton {
                    text: "Archive";
                    enabled: SettingsState.archive-enabled;
                    clicked => {
                        SettingsState.archive-term();
                    }
                }
            }

            if SettingsState.archive-hint != "": MutedText {
                text: SettingsState.archive-hint;
            }

            // R68: inline confirm panel, styled like the restore panel.
            if SettingsState.confirm-archive: Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-none;
                border-width: Theme.divider-width;
                border-color: Theme.border;

                VerticalLayout {
                    padding: Theme.space-lg;
                    spacing: Theme.space-sm;

                    BodyText {
                        text: SettingsState.archive-confirm-text;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        alignment: start;
                        // R84: archiving is destructive, so it uses the danger style.
                        DangerButton {
                            text: "Archive";
                            clicked => {
                                SettingsState.archive-confirm();
                            }
                        }

                        SecondaryButton {
                            text: "Cancel";
                            clicked => {
                                SettingsState.archive-cancel();
                            }
                        }
                    }
                }
            }
        }

        // R67, R69: the form, only with no active term or after Edit.
        if SettingsState.term-form-open: VerticalLayout {
            spacing: Theme.space-sm;
            HorizontalLayout {
                spacing: Theme.space-md;
                Field {
                    label: "Name";
                    text <=> SettingsState.term-name;
                }

                Field {
                    label: "Start (DD-MM-YYYY)";
                    text <=> SettingsState.term-start;
                    error: SettingsState.term-start-error;
                }

                Field {
                    label: "End (DD-MM-YYYY)";
                    text <=> SettingsState.term-end;
                    error: SettingsState.term-end-error;
                }
            }

            if SettingsState.term-form-error != "": FormError {
                text: SettingsState.term-form-error;
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                PrimaryButton {
                    text: "Save term";
                    clicked => {
                        SettingsState.save-term();
                    }
                }

                if SettingsState.has-term: SecondaryButton {
                    text: "Cancel";
                    clicked => {
                        SettingsState.cancel-term();
                    }
                }
            }
        }
    }

    // R70: past terms, read-only.
    SectionCard {
        title: "Past terms";

        if SettingsState.past-terms.length == 0: EmptyState {
            text: "No past terms yet. A term shows here after you archive it.";
        }

        if SettingsState.past-terms.length > 0: VerticalLayout {
            for row in SettingsState.past-terms: ListRow {
                Text {
                    text: row.name;
                    vertical-alignment: center;
                    overflow: elide;
                    color: Theme.on-surface;
                    font-family: Theme.font-body;
                    font-size: Theme.body-emphasis-size;
                    font-weight: Theme.body-emphasis-weight;
                }

                MutedText {
                    text: row.dates;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }

                MutedText {
                    text: row.courses;
                    vertical-alignment: center;
                }

                MutedText {
                    text: row.attendance;
                    vertical-alignment: center;
                }

                MutedText {
                    text: row.gpa;
                    vertical-alignment: center;
                }
            }
        }
    }

    DayOffCard {
        title: "Holidays";
        rows: SettingsState.holidays;
        empty-text: "No holidays yet. Add a date or a range below with Add holiday; no classes are scheduled on holidays.";
        add-text: "Add holiday";
        first-day <=> SettingsState.hol-start;
        last-day <=> SettingsState.hol-end;
        label <=> SettingsState.hol-label;
        first-error: SettingsState.hol-start-error;
        last-error: SettingsState.hol-end-error;
        form-error: SettingsState.hol-form-error;
        add => {
            SettingsState.add-holiday();
        }
        remove(key) => {
            SettingsState.remove-holiday(key);
        }
    }

    DayOffCard {
        title: "Mid exams";
        has-swatch: true;
        swatch: Theme.calendar-midterm;
        rows: SettingsState.midterms;
        empty-text: "No mid exams yet. Add a date or a range below with Add mid exam; no classes are scheduled on exam days.";
        add-text: "Add mid exam";
        first-day <=> SettingsState.mid-start;
        last-day <=> SettingsState.mid-end;
        label <=> SettingsState.mid-label;
        first-error: SettingsState.mid-start-error;
        last-error: SettingsState.mid-end-error;
        form-error: SettingsState.mid-form-error;
        add => {
            SettingsState.add-midterm();
        }
        remove(key) => {
            SettingsState.remove-holiday(key);
        }
    }

    DayOffCard {
        title: "Final exams";
        has-swatch: true;
        swatch: Theme.calendar-final;
        rows: SettingsState.finals;
        empty-text: "No final exams yet. Add a date or a range below with Add final exam; no classes are scheduled on exam days.";
        add-text: "Add final exam";
        first-day <=> SettingsState.fin-start;
        last-day <=> SettingsState.fin-end;
        label <=> SettingsState.fin-label;
        first-error: SettingsState.fin-start-error;
        last-error: SettingsState.fin-end-error;
        form-error: SettingsState.fin-form-error;
        add => {
            SettingsState.add-final();
        }
        remove(key) => {
            SettingsState.remove-holiday(key);
        }
    }

    // R76, R77, R79: government public holidays of the chosen country. They never change classes
    // until Add selected turns ticked ones into holidays.
    SectionCard {
        title: "Public holidays";

        ComboField {
            label: "Country";
            model: SettingsState.ph-countries;
            current-index <=> SettingsState.ph-country-index;
            selected => {
                SettingsState.ph-country-selected();
            }
        }

        if SettingsState.ph-status != "": HorizontalLayout {
            spacing: Theme.space-md;
            MutedText {
                text: SettingsState.ph-status;
                horizontal-stretch: 1;
            }

            if SettingsState.ph-can-retry: LinkButton {
                text: "Retry";
                clicked => {
                    SettingsState.ph-retry();
                }
            }
        }

        if SettingsState.ph-rows.length == 0: EmptyState {
            text: SettingsState.ph-empty-text;
        }

        if SettingsState.ph-rows.length > 0: VerticalLayout {
            for row in SettingsState.ph-rows: ListRow {
                VerticalLayout {
                    alignment: center;
                    CheckBox {
                        checked: row.checked;
                        toggled => {
                            SettingsState.ph-toggle(row.key, self.checked);
                        }
                    }
                }

                Text {
                    text: row.date;
                    vertical-alignment: center;
                    color: Theme.on-surface;
                    font-family: Theme.font-body;
                    font-size: Theme.body-md-size;
                    font-weight: Theme.body-md-weight;
                }

                Text {
                    text: row.name;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    color: Theme.on-surface-muted;
                    font-family: Theme.font-body;
                    font-size: Theme.body-md-size;
                    font-weight: Theme.body-md-weight;
                }
            }
        }

        if SettingsState.ph-error != "": FormError {
            text: SettingsState.ph-error;
        }

        HorizontalLayout {
            alignment: start;
            SecondaryButton {
                text: "Add selected as holidays";
                clicked => {
                    SettingsState.ph-add-selected();
                }
            }
        }
    }

    SectionCard {
        title: "Reminders";

        HorizontalLayout {
            spacing: Theme.space-md;
            Field {
                label: "Class reminder (minutes before)";
                text <=> SettingsState.reminder;
                error: SettingsState.reminder-error;
            }

            Field {
                label: "Upcoming window (days)";
                text <=> SettingsState.window;
                error: SettingsState.window-error;
            }
        }

        Switch {
            text: "Notifications";
            checked <=> SettingsState.notifications;
        }

        if SettingsState.settings-form-error != "": FormError {
            text: SettingsState.settings-form-error;
        }

        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: "Save settings";
                clicked => {
                    SettingsState.save-settings();
                }
            }
        }
    }

    SectionCard {
        title: "Backup and export";

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;
            SecondaryButton {
                text: "Backup…";
                clicked => {
                    SettingsState.backup();
                }
            }

            SecondaryButton {
                text: "Restore…";
                clicked => {
                    SettingsState.restore-pick();
                }
            }

            SecondaryButton {
                text: "Export CSV…";
                clicked => {
                    SettingsState.export-csv();
                }
            }
        }

        // R84: square surface panel with a divider-width edge so it stands out inside its card.
        if SettingsState.confirm-restore: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-none;
            border-width: Theme.divider-width;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;

                BodyText {
                    text: "Restoring replaces all current data with the backup. The current data is copied to the backups folder first.";
                }

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: start;
                    // R84: replacing all data is destructive, so it uses the danger style.
                    DangerButton {
                        text: "Replace all data";
                        clicked => {
                            SettingsState.restore-confirm();
                        }
                    }

                    SecondaryButton {
                        text: "Cancel";
                        clicked => {
                            SettingsState.restore-cancel();
                        }
                    }
                }
            }
        }
    }

    SectionCard {
        title: "Database file";

        BodyText {
            text: SettingsState.db-path;
        }
    }
}
