// About page and update banner (docs/spec.md §13.1 UI, §6, R27–R29;
// specs/007-m7-updater/contracts/ui-about.md). Bindings only; every string comes from Rust
// (src/pages/about.rs via src/viewmodel.rs).
import { Switch, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PageTitle, SectionCard, PrimaryButton, SecondaryButton } from "components.slint";

export global AboutState {
    // Errors from opening a link or saving the switch.
    in property <string> message;

    // §13.1 UI: static About items.
    in property <string> app-name;
    in property <string> version-text;
    in property <string> license-text;
    // R53: `owner/repo` beside the GitHub button.
    in property <string> repo-label;
    in property <string> db-path;

    // R27, R28: update status, action button, and download progress.
    in property <string> status-text;
    in property <string> action-label;
    in property <bool> action-enabled: true;
    in property <bool> downloading;
    // 0.0–1.0, or -1 when the total size is unknown.
    in property <float> progress;
    in property <string> progress-text;
    in property <bool> is-error;

    // R28: inline confirm panel before anything is installed.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-notes;
    in property <string> confirm-label;

    // R29: check for an update once per launch.
    in-out property <bool> check-on-start;

    callback action();
    callback confirm();
    callback cancel();
    callback check-on-start-toggled();
    callback open-repo();
    callback open-notices();
}

// Body text on a card.
component BodyText inherits Text {
    color: Theme.on-surface;
    wrap: word-wrap;
    font-family: Theme.font-body;
    font-size: Theme.body-md-size;
    font-weight: Theme.body-md-weight;
}

// Muted secondary text on a card.
component MutedText inherits Text {
    color: Theme.on-surface-muted;
    wrap: word-wrap;
    font-family: Theme.font-body;
    font-size: Theme.body-sm-size;
    font-weight: Theme.body-sm-weight;
}

// R29: "Version x is available." with View and Dismiss, shown above the page content on every
// page until dismissed for this launch.
export component UpdateBanner inherits Rectangle {
    in property <string> text;
    callback view();
    callback dismiss();

    background: Theme.surface-alt;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: Theme.border;

    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        BodyText {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        PrimaryButton {
            text: "View";
            clicked => {
                root.view();
            }
        }

        SecondaryButton {
            text: "Dismiss";
            clicked => {
                root.dismiss();
            }
        }
    }
}

// R53: GitHub button: inverted ink pill with the GitHub mark and "View on GitHub".
component GitHubButton inherits Rectangle {
    callback clicked();

    height: Theme.input-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    border-width: Theme.border-width;
    border-color: focus-scope.has-focus ? Theme.primary : Theme.on-surface;
    background: touch.has-hover ? Theme.on-surface-muted : Theme.on-surface;
    accessible-role: button;
    accessible-label: "View on GitHub";
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access: Tab reaches the control, Enter or Space activates it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    row := HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;
        alignment: center;

        VerticalLayout {
            alignment: center;
            // GitHub mark (Octicons mark-github, MIT).
            Path {
                width: Theme.link-icon;
                height: Theme.link-icon;
                viewbox-width: 16;
                viewbox-height: 16;
                fill: Theme.surface;
                accessible-role: none;
                commands: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z";
            }
        }

        Text {
            text: "View on GitHub";
            accessible-role: none;
            vertical-alignment: center;
            color: Theme.surface;
            font-family: Theme.font-body;
            font-size: Theme.label-md-size;
            font-weight: Theme.label-md-weight;
        }
    }
}

export component AboutPage inherits VerticalLayout {
    spacing: Theme.space-xl;
    alignment: start;

    PageTitle {
        text: "About";
    }

    if AboutState.message != "": Text {
        text: AboutState.message;
        color: Theme.error;
        wrap: word-wrap;
        font-family: Theme.font-body;
        font-size: Theme.body-md-size;
        font-weight: Theme.body-md-weight;
    }

    SectionCard {
        title: AboutState.app-name;

        BodyText {
            text: AboutState.version-text;
        }

        BodyText {
            text: AboutState.license-text;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;
            GitHubButton {
                clicked => {
                    AboutState.open-repo();
                }
            }

            MutedText {
                text: AboutState.repo-label;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            SecondaryButton {
                text: "Third-party notices";
                clicked => {
                    AboutState.open-notices();
                }
            }
        }
    }

    SectionCard {
        title: "Updates";

        if AboutState.status-text != "": Text {
            text: AboutState.status-text;
            color: AboutState.is-error ? Theme.error : Theme.on-surface;
            wrap: word-wrap;
            font-family: Theme.font-body;
            font-size: Theme.body-md-size;
            font-weight: Theme.body-md-weight;
        }

        if AboutState.downloading: VerticalLayout {
            spacing: Theme.space-xs;
            ProgressIndicator {
                progress: AboutState.progress;
                indeterminate: AboutState.progress < 0;
            }

            MutedText {
                text: AboutState.progress-text;
            }
        }

        if AboutState.confirm-open: Rectangle {
            background: Theme.surface-alt;
            border-radius: Theme.radius-sm;

            VerticalLayout {
                padding: Theme.space-md;
                spacing: Theme.space-sm;

                BodyText {
                    text: AboutState.confirm-title;
                    font-weight: Theme.label-md-weight;
                }

                if AboutState.confirm-notes != "": BodyText {
                    text: AboutState.confirm-notes;
                }

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: start;
                    PrimaryButton {
                        text: AboutState.confirm-label;
                        clicked => {
                            AboutState.confirm();
                        }
                    }

                    SecondaryButton {
                        text: "Cancel";
                        clicked => {
                            AboutState.cancel();
                        }
                    }
                }
            }
        }

        if !AboutState.confirm-open: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: AboutState.action-label;
                enabled: AboutState.action-enabled;
                clicked => {
                    AboutState.action();
                }
            }
        }

        Switch {
            text: "Check for updates when the app starts";
            checked <=> AboutState.check-on-start;
            toggled => {
                AboutState.check-on-start-toggled();
            }
        }
    }

    SectionCard {
        title: "Database";

        MutedText {
            text: AboutState.db-path;
        }
    }
}
