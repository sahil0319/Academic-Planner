// Courses page (docs/spec.md §6, contracts/ui-bridge.md "CoursesState"): course list with the
// show-archived toggle (R3), multi-select delete (R52), course form (R2), and course detail with the attendance summary
// (R13-R15), every session with status actions (R11, R12), and "Add makeup class" (R10).
// Bindings only; every data-derived string comes from src/viewmodel.rs.
import { CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    Chip,
    CourseRow,
    MarkRow,
    NeededRowView,
    SessionRow,
    StatusAction,
    SummaryView,
} from "types.slint";
import { ImportPanel, ImportState } from "import.slint";
import {
    PageTitle,
    EmptyState,
    PrimaryButton,
    SecondaryButton,
    DangerButton,
    Field,
    ComboField,
    TimeField,
    StatusChip,
    SectionCard,
    ListRow,
} from "components.slint";

export global CoursesState {
    // Row-action errors and success notes.
    in property <string> message;

    // R3: the list includes archived courses.
    in-out property <bool> show-archived;
    in property <[CourseRow]> courses;

    // Course detail.
    in property <bool> detail-open;
    in property <string> detail-title;
    in property <SummaryView> summary;
    in property <[SessionRow]> sessions;
    // R14: chip text, from viewmodel::BELOW_TARGET_LABEL.
    in property <string> below-target-label;
    // R40: "Term GPA 3.67 (projected)" in the page header.
    in property <string> gpa-text;
    // R33, R37: Marks card; `graded` false shows `not-graded-line` only.
    in property <bool> graded;
    in property <string> not-graded-line;
    in property <[MarkRow]> mark-rows;
    in property <string> marks-secured;
    in property <string> marks-projected;
    // R38: needed-in-final table, assumption lines, or the actual grade (non-empty = final scored).
    in property <string> needed-caption;
    in property <[NeededRowView]> needed-rows;
    in property <[string]> needed-assumptions;
    in property <string> actual-grade;

    // Course form; `editing-id` is -1 for a new course.
    in-out property <bool> form-open;
    in-out property <int> editing-id: -1;
    in-out property <string> code;
    in-out property <string> name;
    in-out property <string> instructor;
    in-out property <string> room;
    in-out property <string> notes;
    in-out property <string> target;
    in property <string> target-error;
    // R33: credits text (empty = none) and the rule set choice (0 = "Not graded", then the names
    // in `rule-set-options` after it).
    in-out property <string> credits;
    in property <string> credits-error;
    in-out property <int> rule-set;
    in property <[string]> rule-set-options;
    in property <string> course-form-error;

    // R10: "Add makeup class" form.
    in-out property <string> mk-date;
    in-out property <string> mk-start;
    in-out property <bool> mk-start-pm;
    in-out property <string> mk-end;
    in-out property <bool> mk-end-pm;
    in-out property <string> mk-room;
    in-out property <string> mk-note;
    in property <string> mk-date-error;
    in property <string> mk-start-error;
    in property <string> mk-end-error;
    in property <string> mk-form-error;

    // R52: multi-select delete. `selected-count` > 0 shows `delete-label`; the confirm panel
    // shows `confirm-delete-text`.
    in property <int> selected-count;
    in property <bool> all-selected;
    in property <string> delete-label;
    in property <bool> confirm-delete;
    in property <string> confirm-delete-text;

    callback toggle-archived(bool);
    callback toggle-selected(int, bool);
    callback select-all(bool);
    callback ask-delete();
    callback confirm-delete-selected();
    callback cancel-delete();
    callback begin-create();
    callback begin-edit(int);
    callback save-course();
    callback set-archived(int, bool);
    callback open-detail(int);
    callback close-detail();
    callback set-status(int, StatusAction);
    callback add-makeup();
}

// Muted caption above a value; label type (label-sm is reserved for status chips).
component Caption inherits Text {
    color: Theme.on-surface-muted;
    font-family: Theme.font-body;
    font-size: Theme.label-md-size;
    font-weight: Theme.label-md-weight;
}

// Sub-heading inside a card (design review F-09): body-emphasis in ink, above its block.
component SubHeading inherits Text {
    color: Theme.on-surface;
    font-family: Theme.font-body;
    font-size: Theme.body-emphasis-size;
    font-weight: Theme.body-emphasis-weight;
}

// Body text in ink.
component Body inherits Text {
    color: Theme.on-surface;
    vertical-alignment: center;
    overflow: elide;
    font-family: Theme.font-body;
    font-size: Theme.body-md-size;
    font-weight: Theme.body-md-weight;
}

// Muted metadata text.
component Meta inherits Body {
    color: Theme.on-surface-muted;
}

// Error line under a form.
component FormError inherits Text {
    color: Theme.error;
    wrap: word-wrap;
    font-family: Theme.font-body;
    font-size: Theme.body-sm-size;
    font-weight: Theme.body-sm-weight;
}

// One summary figure: caption above value.
component Figure inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    spacing: Theme.space-xs;
    Caption {
        text: root.caption;
    }
    Body {
        text: root.value;
    }
}

export component CoursesPage inherits VerticalLayout {
    spacing: Theme.space-xxl;
    alignment: start;

    PageTitle {
        text: "Courses";
    }

    Text {
        text: CoursesState.gpa-text;
        color: Theme.on-surface;
        font-family: Theme.font-body;
        font-size: Theme.body-emphasis-size;
        font-weight: Theme.body-emphasis-weight;
    }

    if CoursesState.message != "": FormError {
        text: CoursesState.message;
    }

    HorizontalLayout {
        spacing: Theme.space-md;
        alignment: start;
        CheckBox {
            text: "Show archived";
            checked <=> CoursesState.show-archived;
            toggled => {
                CoursesState.toggle-archived(self.checked);
            }
        }
        // Secondary, like "Add slot": terracotta stays on the form's Save.
        SecondaryButton {
            text: "New course";
            clicked => {
                CoursesState.begin-create();
            }
        }
        // M10: opens the import panel below.
        SecondaryButton {
            text: "Import…";
            clicked => {
                ImportState.open = true;
            }
        }
    }

    // M10, R42-R50: course and timetable import.
    if ImportState.open: ImportPanel { }

    // R2: create / edit form; core validation errors show inline.
    if CoursesState.form-open: SectionCard {
        title: "Course";

        HorizontalLayout {
            spacing: Theme.space-md;
            Field {
                label: "Code";
                text <=> CoursesState.code;
            }
            Field {
                label: "Name";
                text <=> CoursesState.name;
                horizontal-stretch: 2;
            }
            Field {
                label: "Target %";
                text <=> CoursesState.target;
                error: CoursesState.target-error;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-md;
            Field {
                label: "Instructor";
                text <=> CoursesState.instructor;
            }
            Field {
                label: "Room";
                text <=> CoursesState.room;
            }
            Field {
                label: "Credits";
                text <=> CoursesState.credits;
                error: CoursesState.credits-error;
            }
            ComboField {
                label: "Rule set";
                model: CoursesState.rule-set-options;
                current-index <=> CoursesState.rule-set;
            }
        }

        Field {
            label: "Notes";
            text <=> CoursesState.notes;
        }

        if CoursesState.course-form-error != "": FormError {
            text: CoursesState.course-form-error;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;
            PrimaryButton {
                text: "Save";
                clicked => {
                    CoursesState.save-course();
                }
            }
            SecondaryButton {
                text: "Cancel";
                clicked => {
                    CoursesState.form-open = false;
                }
            }
        }
    }

    // R13-R15, R10-R12: course detail.
    if CoursesState.detail-open: SectionCard {
        title: CoursesState.detail-title;

        HorizontalLayout {
            spacing: Theme.space-xl;
            alignment: start;
            Figure {
                caption: "Attended";
                value: CoursesState.summary.attended;
            }
            Figure {
                caption: "Absent";
                value: CoursesState.summary.absent;
            }
            Figure {
                caption: "Cancelled";
                value: CoursesState.summary.cancelled;
            }
            Figure {
                caption: "Pending";
                value: CoursesState.summary.pending;
            }
            Figure {
                caption: "Attendance";
                value: CoursesState.summary.pct;
            }
            Figure {
                caption: "Target";
                value: CoursesState.summary.target;
            }
            if CoursesState.summary.below-target: VerticalLayout {
                alignment: center;
                Rectangle {
                    border-radius: Theme.radius-full;
                    background: Theme.below-target-bg;
                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        padding-top: Theme.space-xs;
                        padding-bottom: Theme.space-xs;
                        Text {
                            text: CoursesState.below-target-label;
                            color: Theme.below-target;
                            font-family: Theme.font-body;
                            font-size: Theme.label-sm-size;
                            font-weight: Theme.label-sm-weight;
                        }
                    }
                }
            }
        }

        // F-10: each block of the detail card is a group with space-sm above and between its parts.
        // Marks.
        VerticalLayout {
            padding-top: Theme.space-sm;
            spacing: Theme.space-sm;
            // R33, R35-R37: marks card.
            SubHeading {
                text: "Marks";
            }

            if !CoursesState.graded: Meta {
                text: CoursesState.not-graded-line;
                overflow: elide;
            }

            if CoursesState.graded: VerticalLayout {
                for m in CoursesState.mark-rows: ListRow {
                    Body {
                        text: m.name;
                        horizontal-stretch: 1;
                    }
                    Body {
                        text: m.marks;
                        horizontal-stretch: 0;
                    }
                }
                VerticalLayout {
                    padding-top: Theme.space-md;
                    HorizontalLayout {
                        spacing: Theme.space-xl;
                        alignment: start;
                        Figure {
                            caption: "Secured";
                            value: CoursesState.marks-secured;
                        }
                        Figure {
                            caption: "Projected";
                            value: CoursesState.marks-projected;
                        }
                    }
                }
            }

            // R38: needed in final, or the actual grade once the final is scored.
            if CoursesState.graded && CoursesState.actual-grade != "": Body {
                text: CoursesState.actual-grade;
            }

            if CoursesState.graded && CoursesState.actual-grade == "": VerticalLayout {
                padding-top: Theme.space-md;
                spacing: Theme.space-xs;
                SubHeading {
                    text: CoursesState.needed-caption;
                }
                for r in CoursesState.needed-rows: ListRow {
                    Body {
                        text: r.letter;
                        horizontal-stretch: 1;
                    }
                    Body {
                        text: r.needed;
                        horizontal-stretch: 0;
                    }
                }
                for line in CoursesState.needed-assumptions: Meta {
                    text: line;
                    overflow: elide;
                }
            }
        }

        // Sessions.
        VerticalLayout {
            padding-top: Theme.space-sm;
            spacing: Theme.space-sm;
            SubHeading {
                text: "Sessions";
            }

            if CoursesState.sessions.length == 0: EmptyState {
                text: "No sessions yet. Classes appear here from this course's weekly slots in Timetable → Rules, or add a makeup class below.";
            }

            if CoursesState.sessions.length > 0: ScrollView {
                height: 10 * Theme.row-height;
                VerticalLayout {
                    alignment: start;
                    // DESIGN.md list row: primary text left, muted metadata next to it.
                    for s in CoursesState.sessions: ListRow {
                        Body {
                            text: s.date;
                            horizontal-stretch: 0;
                        }
                        Body {
                            text: s.weekday;
                            horizontal-stretch: 0;
                        }
                        Body {
                            text: s.time;
                            horizontal-stretch: 0;
                        }
                        Meta {
                            text: s.room;
                            horizontal-stretch: 0;
                        }
                        Meta {
                            text: s.note;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            StatusChip {
                                chip: s.chip;
                                text: s.status-label;
                            }
                        }
                        // R12: Attended / Absent only once the session has started.
                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Attended";
                                enabled: s.can-mark;
                                clicked => {
                                    CoursesState.set-status(s.id, StatusAction.attended);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Absent";
                                enabled: s.can-mark;
                                clicked => {
                                    CoursesState.set-status(s.id, StatusAction.absent);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Cancelled";
                                clicked => {
                                    CoursesState.set-status(s.id, StatusAction.cancelled);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Pending";
                                clicked => {
                                    CoursesState.set-status(s.id, StatusAction.pending);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Makeup form.
        VerticalLayout {
            padding-top: Theme.space-sm;
            spacing: Theme.space-sm;
            SubHeading {
                text: "Add makeup class";
            }

            HorizontalLayout {
                spacing: Theme.space-md;
                Field {
                    label: "Date (DD-MM-YYYY)";
                    text <=> CoursesState.mk-date;
                    error: CoursesState.mk-date-error;
                }
                TimeField {
                    label: "Start";
                    text <=> CoursesState.mk-start;
                    pm <=> CoursesState.mk-start-pm;
                    error: CoursesState.mk-start-error;
                }
                TimeField {
                    label: "End";
                    text <=> CoursesState.mk-end;
                    pm <=> CoursesState.mk-end-pm;
                    error: CoursesState.mk-end-error;
                }
                Field {
                    label: "Room";
                    text <=> CoursesState.mk-room;
                }
            }

            Field {
                label: "Note";
                text <=> CoursesState.mk-note;
            }

            if CoursesState.mk-form-error != "": FormError {
                text: CoursesState.mk-form-error;
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                PrimaryButton {
                    text: "Add makeup class";
                    clicked => {
                        CoursesState.add-makeup();
                    }
                }
                SecondaryButton {
                    text: "Close";
                    clicked => {
                        CoursesState.close-detail();
                    }
                }
            }
        }
    }

    SectionCard {
        title: "All courses";

        if CoursesState.courses.length == 0: EmptyState {
            text: "No courses yet. Your courses appear here; add one with New course above.";
        }

        // R52: select courses, then delete them after a confirm.
        if CoursesState.courses.length > 0: HorizontalLayout {
            spacing: Theme.space-md;
            alignment: start;
            CheckBox {
                text: "Select all";
                checked: CoursesState.all-selected;
                toggled => {
                    CoursesState.select-all(self.checked);
                }
            }
            // R84: delete is a destructive action, so it uses the danger style.
            if CoursesState.selected-count > 0 && !CoursesState.confirm-delete: DangerButton {
                text: CoursesState.delete-label;
                clicked => {
                    CoursesState.ask-delete();
                }
            }
        }

        // R84: square surface panel with a divider-width edge so it stands out inside its card.
        if CoursesState.confirm-delete: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-none;
            border-width: Theme.divider-width;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;

                Body {
                    text: CoursesState.confirm-delete-text;
                    wrap: word-wrap;
                    overflow: clip;
                }

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: start;
                    DangerButton {
                        text: CoursesState.delete-label;
                        clicked => {
                            CoursesState.confirm-delete-selected();
                        }
                    }

                    SecondaryButton {
                        text: "Cancel";
                        clicked => {
                            CoursesState.cancel-delete();
                        }
                    }
                }
            }
        }

        if CoursesState.courses.length > 0: VerticalLayout {
            for c in CoursesState.courses: ListRow {
                VerticalLayout {
                    alignment: center;
                    CheckBox {
                        checked: c.selected;
                        toggled => {
                            CoursesState.toggle-selected(c.id, self.checked);
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        // F-07: a fixed code column and a left-aligned name give every row the
                        // same name edge.
                        Body {
                            text: c.code;
                            width: Theme.code-column-width;
                            horizontal-stretch: 0;
                            font-size: Theme.body-emphasis-size;
                            font-weight: Theme.body-emphasis-weight;
                        }
                        Body {
                            text: c.name;
                            horizontal-alignment: left;
                            horizontal-stretch: 1;
                        }
                        // R3: archived courses are marked in the list.
                        if c.archived: VerticalLayout {
                            alignment: center;
                            StatusChip {
                                chip: Chip.cancelled;
                                text: "Archived";
                            }
                        }
                    }
                    // F-07: label and value pairs are separated by space-md.
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        alignment: start;
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            Caption {
                                text: "Instructor";
                                vertical-alignment: center;
                            }
                            Meta {
                                text: c.instructor;
                                horizontal-stretch: 0;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            Caption {
                                text: "Room";
                                vertical-alignment: center;
                            }
                            Meta {
                                text: c.room;
                                horizontal-stretch: 0;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            Caption {
                                text: "Target";
                                vertical-alignment: center;
                            }
                            Meta {
                                text: c.target;
                                horizontal-stretch: 0;
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        text: "Details";
                        clicked => {
                            CoursesState.open-detail(c.id);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        text: "Edit";
                        clicked => {
                            CoursesState.begin-edit(c.id);
                        }
                    }
                }
                if !c.archived: VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        text: "Archive";
                        clicked => {
                            CoursesState.set-archived(c.id, true);
                        }
                    }
                }
                if c.archived: VerticalLayout {
                    alignment: center;
                    SecondaryButton {
                        text: "Unarchive";
                        clicked => {
                            CoursesState.set-archived(c.id, false);
                        }
                    }
                }
            }
        }
    }
}
