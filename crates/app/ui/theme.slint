// Design tokens from DESIGN.md. The only place colors and sizes are defined.
// Values are copied exactly from the DESIGN.md front matter (research R-D13).
import { Palette } from "std-widgets.slint";

export global Theme {
    // Appearance (§6 "Appearance:", DESIGN.md "Theme"): 0 System, 1 Light, 2 Dark. Rust sets it
    // from settings().theme at start and when the appearance switch is clicked.
    in-out property <int> mode;
    // Effective dark scheme. In System mode Palette.color-scheme holds the OS value until Rust
    // first sets it, then `unknown` (std-widgets follow the OS). `unknown` does not say which
    // scheme the OS uses, so the std-widgets background (dark in a dark scheme) decides then.
    out property <bool> dark: mode == 2 || (mode == 0 && (Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && std-background.to-hsv().value < 0.5)));
    property <color> std-background: Palette.background;

    // Colors: each token is `dark ? <DESIGN.md dark-*> : <DESIGN.md light>`.
    out property <color> primary: dark ? #D9774F : #B4532F;
    out property <color> primary-hover: dark ? #E48A63 : #9C4526;
    out property <color> on-primary: dark ? #1C1B18 : #FFFFFF;
    out property <color> neutral: dark ? #1C1B18 : #F5F4ED;
    out property <color> surface: dark ? #24221E : #FDFCF9;
    out property <color> surface-alt: dark ? #2B2924 : #EFEDE5;
    out property <color> surface-selected: dark ? #38352E : #E4E1D6;
    out property <color> border: dark ? #3A372F : #E3E0D5;
    out property <color> on-surface: dark ? #EDEAE0 : #1F1E1B;
    out property <color> on-surface-muted: dark ? #A8A396 : #68645B;
    out property <color> error: dark ? #EF8A72 : #A8321F;
    out property <color> status-attended: dark ? #93CBA2 : #2F6B3F;
    out property <color> status-attended-bg: dark ? #22362A : #E4EEE1;
    out property <color> status-absent: dark ? #F29B87 : #A8321F;
    out property <color> status-absent-bg: dark ? #43261F : #F8E4DE;
    out property <color> status-cancelled: dark ? #B9B4A8 : #68645B;
    out property <color> status-cancelled-bg: dark ? #302E29 : #ECEAE2;
    out property <color> status-pending: dark ? #E6BD6A : #7F5610;
    out property <color> status-pending-bg: dark ? #3B3121 : #F6ECD2;
    out property <color> below-target: dark ? #F2A985 : #8A3A1A;
    out property <color> below-target-bg: dark ? #40291D : #F6E3D6;

    // Typography families. Empty string = platform default (system-ui, and the Georgia fallback).
    out property <string> font-heading: "Georgia";
    out property <string> font-body: "";

    // Typography sizes and weights. Slint Text has no line-height, so line heights are comments.
    // title-lg: Georgia, line height 1.25
    out property <length> title-lg-size: 22px;
    out property <int> title-lg-weight: 400;
    // headline-md: Georgia, line height 1.3
    out property <length> headline-md-size: 16px;
    out property <int> headline-md-weight: 400;
    // body-md: system-ui, line height 1.45
    out property <length> body-md-size: 13px;
    out property <int> body-md-weight: 400;
    // body-sm: system-ui, line height 1.4
    out property <length> body-sm-size: 12px;
    out property <int> body-sm-weight: 400;
    // label-md: system-ui, line height 1.2
    out property <length> label-md-size: 12px;
    out property <int> label-md-weight: 600;
    // label-sm: system-ui, line height 1.2
    out property <length> label-sm-size: 11px;
    out property <int> label-sm-weight: 600;

    // Radii
    out property <length> radius-none: 0px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-full: 9999px;

    // Spacing
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-xxl: 32px;

    // Sizes
    out property <length> nav-width: 208px;
    out property <length> row-height: 34px;
    out property <length> input-height: 30px;
    out property <length> window-width: 1100px;
    out property <length> window-height: 720px;
    out property <length> divider-width: 1px;
    out property <length> border-width: 1px;
    // DESIGN.md "Mini calendar": 36px day cells, the today circle inside a cell, the 4px due dot.
    out property <length> calendar-cell: 36px;
    out property <length> calendar-today: 22px;
    out property <length> calendar-marker: 4px;
    // DESIGN.md "Mini calendar": holiday and exam period highlight, primary #B4532F at about 15%
    // opacity; dark: dark-primary #D9774F at about 22% opacity (DESIGN.md "Dark theme tokens").
    out property <color> calendar-holiday-highlight: dark ? #D9774F38 : #B4532F26;

    // DESIGN.md "Appearance switch": 28px icon segments.
    out property <length> appearance-segment: 28px;
    // Monitor, sun, and moon icon size inside a segment, and the icon stroke width.
    out property <length> appearance-icon: 16px;
    out property <length> appearance-icon-stroke: 1.5px;
}
