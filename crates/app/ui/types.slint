// Shared Slint types (contracts/ui-bridge.md). Rust fills these through src/bridge.rs;
// every string is already formatted by src/viewmodel.rs.

// Chip colors of a session status (R11).
export enum Chip { attended, absent, cancelled, pending }

// Status a row action asks for; src/bridge.rs maps it to planner_core::Status (R11).
export enum StatusAction { attended, absent, cancelled, pending }

export struct SessionRow {
    id: int,
    date: string,
    weekday: string,
    time: string,
    course: string,
    room: string,
    status-label: string,
    chip: Chip,
    // R12: attendance can be marked only once the session has started.
    can-mark: bool,
    note: string,
}

export struct DayGroup {
    title: string,
    rows: [SessionRow],
}

export struct AssessmentRow {
    id: int,
    course-code: string,
    kind: string,
    title: string,
    due: string,
    completed: bool,
    notes: string,
}

// One mini calendar cell (§6 mini calendar change, DESIGN.md "Mini calendar").
export struct CalendarDay {
    // ISO date; identity passed back to Rust, never shown.
    key: string,
    day: string,
    in-month: bool,
    is-today: bool,
    is-selected: bool,
    // R3: at least one non-cancelled class of a non-archived course.
    has-class: bool,
    // At least one incomplete assessment due.
    has-due: bool,
    // Saturday or Sunday.
    is-weekend: bool,
    // Holiday label for the date: "Holiday" when unlabeled, "" when not a holiday.
    holiday: string,
    // Accessible label, e.g. "Monday, October 26, 2026, 2 classes, 1 assessment due".
    label: string,
}

// Seven calendar cells, Monday to Sunday.
export struct CalendarWeek {
    days: [CalendarDay],
}

export struct CourseRow {
    id: int,
    code: string,
    name: string,
    instructor: string,
    room: string,
    target: string,
    archived: bool,
}

export struct SlotRow {
    id: int,
    weekday: string,
    time: string,
    course: string,
    room: string,
    valid: string,
}

export struct HolidayRow {
    key: string,
    date: string,
    label: string,
}

// R13-R15: attendance summary as display text.
export struct SummaryView {
    attended: string,
    absent: string,
    cancelled: string,
    pending: string,
    pct: string,
    target: string,
    below-target: bool,
}

export global AppState {
    // 0 Dashboard, 1 Timetable, 2 Courses, 3 Assessments, 4 Settings, 5 About, 6 Rules (M9)
    in-out property <int> current-page;
    // FR-008: non-empty means only the error screen is shown.
    in property <string> startup-error;
    // Rust refreshes all pages with a fresh `now`.
    callback page-selected(int);
    // §6 "Appearance:": appearance switch segment clicked (0 System, 1 Light, 2 Dark). Rust sets
    // Theme.mode at once and saves the choice in settings.
    callback theme-selected(int);
    // R29: "Version x is available." banner text; "" hides it.
    in property <string> update-banner;
    // R29: banner View goes to About; Dismiss hides it for this launch.
    callback update-banner-view();
    callback update-banner-dismiss();
}

// M9 (contracts/ui-grading.md): grading rows as display text; Rust fills them via the view model.
export struct MarkRow {
    name: string,
    marks: string,
}

export struct NeededRowView {
    letter: string,
    needed: string,
}

export struct RuleSetRow {
    id: int,
    name: string,
    summary: string,
}

export struct ComponentRow {
    // Stored component id, or -1 for a row not saved yet (R34: update in place by id).
    id: int,
    name: string,
    // true = Items, false = Attendance.
    is-items: bool,
    weight: string,
    item-count: string,
    best-count: string,
    item-max: string,
    is-final: bool,
    error: string,
}

export struct BandRow {
    min: string,
    credit: string,
    error: string,
}

export struct GradeRowView {
    letter: string,
    min: string,
    points: string,
    error: string,
}

// M10: styling hint of one import-preview line (src/viewmodel/import.rs `LineKind`).
export enum ImportLineKind { heading, error, summary, section, item, detail, warning }

// M10: one line of the import-preview result area; the text is already formatted.
export struct ImportLine {
    text: string,
    kind: ImportLineKind,
}
