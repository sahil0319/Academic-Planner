// Main window: left navigation and the current page (docs/spec.md §6, FR-004), or only the
// startup error when the database cannot be opened (FR-008).
// R83: IBM Plex Sans 400 and 600, embedded in the binary. Release @ibm/plex-sans@1.1.0
// (github.com/IBM/plex), fonts/complete/ttf/, licence in fonts/OFL.txt (SIL OFL 1.1).
// SHA-256 IBMPlexSans-Regular.ttf:  975dcda37d80f038dcd143c22e33ca2d97a0cc5a929aace1c749153b0fe1afa5
// SHA-256 IBMPlexSans-SemiBold.ttf: a20caf8286023a6a7a85e40b1d2a4ae9fc3e3b1f9eda8f4c542dd4986af67bb1
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "types.slint";
import { NavItem, PageTitle, AppearanceSwitch } from "components.slint";
import { DashboardPage, DashboardState } from "dashboard.slint";
import { TimetablePage, TimetableState } from "timetable.slint";
import { CoursesPage, CoursesState } from "courses.slint";
import { AssessmentsPage, AssessmentsState } from "assessments.slint";
import { SettingsPage, SettingsState } from "settings.slint";
import { AboutPage, AboutState, UpdateBanner } from "about.slint";
import { RulesPage, RulesState } from "rules.slint";
import { ImportState } from "import.slint";

export {
    Chip,
    StatusAction,
    SessionRow,
    DayGroup,
    AssessmentRow,
    CourseRow,
    SlotRow,
    HolidayRow,
    SummaryView,
    AppState,
    RuleSetRow,
    ComponentRow,
    BandRow,
    GradeRowView,
    ImportLine,
    ImportLineKind,
} from "types.slint";
export {
    DashboardState,
    TimetableState,
    CoursesState,
    AssessmentsState,
    SettingsState,
    AboutState,
    RulesState,
    ImportState,
}
// Rust sets Theme.mode and the std-widgets color scheme (§6 "Appearance:").
export { Theme, Palette }

export component AppWindow inherits Window {
    title: "Academic Planner";
    background: Theme.neutral;
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;

    if AppState.startup-error != "": VerticalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-md;
        alignment: start;
        PageTitle {
            text: "The database could not be opened";
        }
        Text {
            text: AppState.startup-error;
            color: Theme.error;
            wrap: word-wrap;
            font-family: Theme.font-body;
            font-size: Theme.body-md-size;
            font-weight: Theme.body-md-weight;
        }
    }

    if AppState.startup-error == "": HorizontalLayout {
        Rectangle {
            width: Theme.nav-width;
            background: Theme.surface-alt;

            VerticalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-xs;
                alignment: start;

                NavItem {
                    text: "Dashboard";
                    active: AppState.current-page == 0;
                    clicked => {
                        AppState.current-page = 0;
                        AppState.page-selected(0);
                    }
                }
                NavItem {
                    text: "Timetable";
                    active: AppState.current-page == 1;
                    clicked => {
                        AppState.current-page = 1;
                        AppState.page-selected(1);
                    }
                }
                NavItem {
                    text: "Courses";
                    active: AppState.current-page == 2;
                    clicked => {
                        AppState.current-page = 2;
                        AppState.page-selected(2);
                    }
                }
                NavItem {
                    text: "Assessments";
                    active: AppState.current-page == 3;
                    clicked => {
                        AppState.current-page = 3;
                        AppState.page-selected(3);
                    }
                }
                NavItem {
                    text: "Rules";
                    active: AppState.current-page == 6;
                    clicked => {
                        AppState.current-page = 6;
                        AppState.page-selected(6);
                    }
                }
                NavItem {
                    text: "Settings";
                    active: AppState.current-page == 4;
                    clicked => {
                        AppState.current-page = 4;
                        AppState.page-selected(4);
                    }
                }
                NavItem {
                    text: "About";
                    active: AppState.current-page == 5;
                    clicked => {
                        AppState.current-page = 5;
                        AppState.page-selected(5);
                    }
                }
            }
        }

        Rectangle {
            background: Theme.neutral;

            VerticalLayout {
                // R29: the update banner sits above the page content, below the title row that
                // holds the appearance switch, on every page.
                if AppState.update-banner != "": VerticalLayout {
                    padding-left: Theme.space-xl;
                    padding-right: Theme.space-xl;
                    padding-top: Theme.space-lg * 2 + Theme.appearance-segment;
                    UpdateBanner {
                        text: AppState.update-banner;
                        view => {
                            AppState.update-banner-view();
                        }
                        dismiss => {
                            AppState.update-banner-dismiss();
                        }
                    }
                }

                ScrollView {
                    VerticalLayout {
                        padding: Theme.space-xl;
                        alignment: start;

                        if AppState.current-page == 0: DashboardPage { }
                        if AppState.current-page == 1: TimetablePage { }
                        if AppState.current-page == 2: CoursesPage { }
                        if AppState.current-page == 3: AssessmentsPage { }
                        if AppState.current-page == 4: SettingsPage { }
                        if AppState.current-page == 5: AboutPage { }
                        if AppState.current-page == 6: RulesPage { }
                    }
                }
            }

            // §6 "Appearance:": fixed in the content area's top-right corner; it does not scroll
            // and sits in the title row, whose page title is on the left.
            AppearanceSwitch {
                x: parent.width - self.width - Theme.space-lg;
                y: Theme.space-lg;
                selected: Theme.mode;
                select(i) => {
                    AppState.theme-selected(i);
                }
            }
        }
    }

    // §6 "Appearance:": the switch also shows on the startup error screen.
    if AppState.startup-error != "": AppearanceSwitch {
        x: parent.width - self.width - Theme.space-lg;
        y: Theme.space-lg;
        selected: Theme.mode;
        select(i) => {
            AppState.theme-selected(i);
        }
    }
}
