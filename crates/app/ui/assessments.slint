// Assessments page (docs/spec.md §6, FR-020): filters upcoming / overdue / completed / all
// (R18, R19), a complete checkbox per row, and a create / edit form with inline errors (FR-007, R2).
// Rust (src/pages/assessments.rs) fills every data-derived string; this file only binds.
import { CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AssessmentRow } from "types.slint";
import {
    FocusRing,
    PageTitle,
    EmptyState,
    SectionCard,
    ListRow,
    Field,
    ComboField,
    TimeField,
    PrimaryButton,
    SecondaryButton,
} from "components.slint";

export global AssessmentsState {
    // Row-action errors.
    in property <string> message;

    // 0 Upcoming, 1 Overdue, 2 Completed, 3 All (viewmodel::filter_from_index).
    in-out property <int> filter;
    // List title and empty-state sentence for the filter (viewmodel::filter_title,
    // viewmodel::filter_empty_text).
    in property <string> list-title: "Upcoming";
    in property <string> empty-text: "No upcoming assessments. Add one in the New assessment form below.";
    in property <[AssessmentRow]> rows;
    // Combo labels from viewmodel::course_option_label: active courses, plus the archived course
    // of the assessment being edited (R3).
    in property <[string]> course-options;
    // Combo labels from viewmodel::assessment_kind_label, index order of
    // viewmodel::assessment_kind_from_index.
    in property <[string]> kind-options;

    // Form fields; `course` and `kind` are combo indexes (-1 = none chosen).
    in-out property <int> course: -1;
    in-out property <int> kind: -1;
    in-out property <string> title;
    in-out property <string> due-date;
    in-out property <string> due-time;
    in-out property <bool> due-time-pm;
    in-out property <string> notes;
    in-out property <string> remind;
    // R36: "Counts toward" choice (0 = "Not counted", then the components of the course's rule
    // set), the score text (empty = none), and the "/ max" label of the chosen component.
    in-out property <int> component;
    in property <[string]> component-options;
    in-out property <string> score;
    in property <string> score-max;
    // Id of the assessment being edited, or -1 when the form creates a new one.
    in-out property <int> editing-id: -1;

    // FR-007 field errors and R2 errors from core (shown as the form error).
    in property <string> course-error;
    in property <string> kind-error;
    in property <string> due-date-error;
    in property <string> due-time-error;
    in property <string> remind-error;
    in property <string> score-error;
    in property <string> form-error;

    callback set-filter(int);
    callback begin-create();
    callback begin-edit(int);
    callback save();
    callback set-completed(int, bool);
    callback delete(int);
    // The user picked another course or component; Rust refreshes the dependent choice.
    callback course-changed();
    callback component-changed();
}

// R84: one filter choice (research D11): a square control with a border-strong edge; the active
// one uses surface-selected with label weight 600, hover surface-hover, and focus is an inset ring.
component FilterTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: Theme.input-height;
    min-width: label.preferred-width + 2 * Theme.space-lg;
    horizontal-stretch: 0;
    border-radius: Theme.radius-none;
    border-width: Theme.control-edge-width;
    border-color: Theme.border-strong;
    background: root.active ? Theme.surface-selected : touch.has-hover ? Theme.surface-hover : Theme.field;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard access (T028 critique): Tab reaches the tab, Enter or Space selects it.
    focus-scope := FocusScope {
        x: 0;
        width: 0; // clicks go to the TouchArea
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    label := Text {
        text: root.text;
        // The tab carries the accessible label.
        accessible-role: none;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.on-surface;
        font-family: Theme.font-body;
        font-size: Theme.body-md-size;
        font-weight: root.active ? Theme.body-emphasis-weight : Theme.body-md-weight;
    }

    // F-05: the selected tab carries a rule-width primary bar on its bottom edge (the active-nav
    // device), so selection does not rest on weight alone when surface-selected equals field.
    if root.active: Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: Theme.rule-width;
        background: Theme.primary;
    }

    if focus-scope.has-focus: FocusRing {}
}

component RowText inherits Text {
    in property <bool> muted;
    in property <bool> strong;

    vertical-alignment: center;
    overflow: elide;
    color: root.muted ? Theme.on-surface-muted : Theme.on-surface;
    font-family: Theme.font-body;
    font-size: Theme.body-md-size;
    font-weight: root.strong ? Theme.body-emphasis-weight : Theme.body-md-weight;
}

export component AssessmentsPage inherits VerticalLayout {
    spacing: Theme.space-xxl;
    alignment: start;

    PageTitle {
        text: "Assessments";
    }

    HorizontalLayout {
        spacing: Theme.space-sm;
        alignment: start;

        FilterTab {
            text: "Upcoming";
            active: AssessmentsState.filter == 0;
            clicked => {
                AssessmentsState.set-filter(0);
            }
        }
        FilterTab {
            text: "Overdue";
            active: AssessmentsState.filter == 1;
            clicked => {
                AssessmentsState.set-filter(1);
            }
        }
        FilterTab {
            text: "Completed";
            active: AssessmentsState.filter == 2;
            clicked => {
                AssessmentsState.set-filter(2);
            }
        }
        FilterTab {
            text: "All";
            active: AssessmentsState.filter == 3;
            clicked => {
                AssessmentsState.set-filter(3);
            }
        }
    }

    if AssessmentsState.message != "": Text {
        text: AssessmentsState.message;
        color: Theme.error;
        wrap: word-wrap;
        font-family: Theme.font-body;
        font-size: Theme.body-md-size;
        font-weight: Theme.body-md-weight;
    }

    SectionCard {
        title: AssessmentsState.list-title;

        if AssessmentsState.rows.length == 0: EmptyState {
            text: AssessmentsState.empty-text;
        }

        if AssessmentsState.rows.length > 0: VerticalLayout {
            for row in AssessmentsState.rows: ListRow {
                CheckBox {
                    horizontal-stretch: 0;
                    checked: row.completed;
                    toggled => {
                        AssessmentsState.set-completed(row.id, self.checked);
                    }
                }
                RowText {
                    horizontal-stretch: 0;
                    text: row.course-code;
                    strong: true;
                }
                RowText {
                    horizontal-stretch: 0;
                    text: row.kind;
                    muted: true;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    RowText {
                        text: row.title;
                        muted: row.completed;
                    }
                    if row.notes != "": RowText {
                        text: row.notes;
                        muted: true;
                        font-size: Theme.body-sm-size;
                    }
                }
                RowText {
                    horizontal-stretch: 0;
                    text: row.due;
                    muted: true;
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    SecondaryButton {
                        text: "Edit";
                        clicked => {
                            AssessmentsState.begin-edit(row.id);
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    SecondaryButton {
                        text: "Delete";
                        clicked => {
                            AssessmentsState.delete(row.id);
                        }
                    }
                }
            }
        }
    }

    SectionCard {
        title: AssessmentsState.editing-id >= 0 ? "Edit assessment" : "New assessment";

        HorizontalLayout {
            spacing: Theme.space-md;
            ComboField {
                label: "Course";
                model: AssessmentsState.course-options;
                current-index <=> AssessmentsState.course;
                error: AssessmentsState.course-error;
                selected => {
                    AssessmentsState.course-changed();
                }
            }
            ComboField {
                label: "Kind";
                model: AssessmentsState.kind-options;
                current-index <=> AssessmentsState.kind;
                error: AssessmentsState.kind-error;
            }
        }

        Field {
            label: "Title";
            text <=> AssessmentsState.title;
        }

        HorizontalLayout {
            spacing: Theme.space-md;
            Field {
                label: "Due date (DD-MM-YYYY)";
                text <=> AssessmentsState.due-date;
                error: AssessmentsState.due-date-error;
            }
            TimeField {
                label: "Due time";
                text <=> AssessmentsState.due-time;
                pm <=> AssessmentsState.due-time-pm;
                error: AssessmentsState.due-time-error;
            }
            Field {
                label: "Reminder (minutes before, optional)";
                text <=> AssessmentsState.remind;
                error: AssessmentsState.remind-error;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-md;
            ComboField {
                label: "Counts toward";
                model: AssessmentsState.component-options;
                current-index <=> AssessmentsState.component;
                selected => {
                    AssessmentsState.component-changed();
                }
            }
            HorizontalLayout {
                spacing: Theme.space-sm;
                Field {
                    label: "Score (optional)";
                    text <=> AssessmentsState.score;
                    error: AssessmentsState.score-error;
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    padding-top: Theme.label-md-size + Theme.space-xs;
                    RowText {
                        text: AssessmentsState.score-max;
                        muted: true;
                    }
                }
            }
        }

        Field {
            label: "Notes (optional)";
            text <=> AssessmentsState.notes;
        }

        if AssessmentsState.form-error != "": Text {
            text: AssessmentsState.form-error;
            color: Theme.error;
            wrap: word-wrap;
            font-family: Theme.font-body;
            font-size: Theme.body-sm-size;
            font-weight: Theme.body-sm-weight;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;
            PrimaryButton {
                text: "Save";
                clicked => {
                    AssessmentsState.save();
                }
            }
            SecondaryButton {
                text: AssessmentsState.editing-id >= 0 ? "Cancel" : "Clear";
                clicked => {
                    AssessmentsState.begin-create();
                }
            }
        }
    }
}
